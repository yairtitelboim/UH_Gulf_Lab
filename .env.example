# Copy this file to .env.local and fill in the values.
# Only VITE_* variables are exposed to the browser, so never put secret keys here.

# Mapbox public token (starts with pk.). Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Supabase project URL and anon (public) key.
# Use the class values your instructor shares, or your own project's values from
# Supabase dashboard -> Project Settings -> API.
# Leave these blank to run on the bundled sample data in public/sample-projects.json.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
